{
  "name": "mkrouter",
  "private": true,
  "version": "1.1.5",
  "description": "A smart local AI gateway for cost-aware, reliability-first multi-channel routing",
  "repository": "https://github.com/minkicc/mkrouter",
  "homepage": "https://github.com/minkicc/mkrouter",
  "bugs": "https://github.com/minkicc/mkrouter/issues",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "resource:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/generate-windows-resource.ps1",
    "backend:build": "node scripts/build-backend.mjs",
    "portable:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "dev": "npm run backend:build && tauri dev",
    "build": "npm run backend:build && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
